# ── Core ─────────────────────────────────────────────────────────────
# Generate both secrets with:  npm run gen:secrets
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
BETTER_AUTH_URL=http://localhost:3000

# Local dev (npm run dev). Docker Compose sets these itself.
DATABASE_URL=postgres://jobiza:jobiza@localhost:5432/jobiza
REDIS_URL=redis://localhost:6379

# ── Library storage ──────────────────────────────────────────────
# Docker Compose sets these to a shared volume. Locally they default to ./data.
# UPLOAD_DIR=./data/uploads
# MODEL_CACHE_DIR=./data/models
# Optional: sent to OpenAlex/Crossref so they can contact you about heavy use.
CONTACT_EMAIL=

# ── Email (magic links, verification, password reset) ───────────────
# Leave SMTP_URL empty in dev to print emails to the server console.
# Docker Compose points this at Mailpit (http://localhost:8025).
SMTP_URL=
EMAIL_FROM="Jobiza <no-reply@localhost>"

# ── Google sign-in (optional) ───────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── ORCID sign-in (optional) ────────────────────────────────────────
# https://orcid.org/developer-tools  (use https://sandbox.orcid.org while developing)
# Redirect URI: {BETTER_AUTH_URL}/api/auth/oauth2/callback/orcid
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_BASE_URL=https://orcid.org
